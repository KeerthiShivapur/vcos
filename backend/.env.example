# VCOS Production Environment Configuration
# Copy this file to .env and fill in all values
# NEVER commit this file with real credentials

# Application
APP_NAME=VCOS
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

# Security (REQUIRED in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-strong-secret-key-here-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=24
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=72
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
EMAIL_VERIFICATION_REQUIRED=true

# Database (REQUIRED)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/vcos
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
EXPECTED_DATABASE_NAME=vcos

# Redis (optional, but recommended for production)
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true

# CORS (REQUIRED in production - comma-separated list of allowed origins)
CORS_ORIGINS=https://app.vcos.io,https://api.vcos.io

# Email (REQUIRED for production - use smtp)
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@vcos.io
EMAIL_TRANSPORT=smtp

# AI Provider (REQUIRED if not using local)
AI_PROVIDER=groq
AI_API_KEY=your-ai-api-key
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
AI_MAX_TOKENS=2048
AI_RETRIES=2
AI_CACHE_ENABLED=true

# Embeddings
EMBEDDING_PROVIDER=groq
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=https://api.groq.com/openai/v1
EMBEDDING_API_KEY=your-groq-api-key

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# CORS (comma-separated)
CORS_ORIGINS=https://app.vcos.io,https://api.vcos.io