# VCOS backend configuration
# Copy to .env and adjust for your environment.

APP_NAME=VCOS
APP_ENV=development
DEBUG=true

# Security — CHANGE IN PRODUCTION
SECRET_KEY=vcos-dev-secret-change-me-in-production-0f8a2b1c
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# PostgreSQL (async driver)
DATABASE_URL=postgresql+asyncpg://postgres:keerthi@localhost:5432/vcos2

# Redis (optional — platform degrades gracefully when disabled/unavailable)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email (console transport prints emails to the server log)
EMAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@vcos.io

# AI Gateway foundation (leave "none" during Phase 1; plug providers in later)
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
